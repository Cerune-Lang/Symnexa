import "std:fs::bytes" as fs;
import "elf.ceru" as elf;

// Place read-only PROGBITS sections in ELF section-table order up to the symbol's section.
fn rodata_offset(data: [u8], table: u64, wanted: u64) -> i64 {
    mut size: u64 = 0;
    for (mut i: u64 = 1; i <= wanted; i = i + 1) {
        s: elf::Section = elf::section(data, table, i);
        if s.kind == 1 && (s.flags & 7) == 2 {
            if !elf::fits(s.offset, s.size, u64(array_len(data))) { return -1; }
            if s.alignment > 1 && (s.alignment & (s.alignment - 1)) != 0 { return -1; }
            start: u64 = elf::align_up(size, s.alignment);
            if !elf::fits(start, s.size, 67108864) { return -1; }
            if i == wanted { return i64(start); }
            size = start + s.size;
        }
    }
    return -1;
}

fn apply(data: [u8], obj: elf::Object) -> void {
    if !obj.has_rela { print("missing RELA section"); return; }
    record: i64 = i64(obj.rela.offset);
    place: u64 = elf::le(data, record, 8);
    info: u64 = elf::le(data, record + 8, 8);
    index: u64 = info >> 32;
    if (info & 4294967295u64) != 2 { print("expected R_X86_64_PC32"); return; }
    if !elf::fits(place, 4, obj.text.size) || index >= obj.sym.size / 24 { print("invalid relocation offset or symbol"); return; }
    ref_at: i64 = i64(obj.sym.offset + index * 24);
    value: u64 = elf::le(data, ref_at + 8, 8);
    definition: u64 = elf::le(data, ref_at + 6, 2);
    if definition == 0 || definition >= obj.count { print("expected a defined symbol"); return; }
    owner: elf::Section = elf::section(data, obj.table, definition);
    if value > owner.size { print("symbol outside section"); return; }

    // Subtract offsets from the text base so S - P fits in a signed integer.
    mut symbol_offset: u64 = value;
    if definition != obj.text_index {
        start: i64 = rodata_offset(data, obj.table, definition);
        if start < 0 { print("expected a placed read-only PROGBITS section"); return; }
        symbol_offset = elf::align_up(obj.text.size, 4096) + u64(start) + value;
    }

    mut main_offset: i64 = -1;
    for (mut i: u64 = 1; i < obj.sym.size / 24; i = i + 1) {
        at: i64 = i64(obj.sym.offset + i * 24);
        name: u64 = elf::le(data, at, 4);
        if elf::le(data, at + 6, 2) == obj.text_index && elf::fits(name, 5, obj.names.size) {
            pos: i64 = i64(obj.names.offset + name);
            if data[pos] == 109 && data[pos + 1] == 97 && data[pos + 2] == 105
                && data[pos + 3] == 110 && data[pos + 4] == 0 {
                offset: u64 = elf::le(data, at + 8, 8);
                if main_offset >= 0 || offset >= obj.text.size { print("invalid main symbol"); return; }
                main_offset = i64(offset);
            }
        }
    }
    if main_offset < 0 { print("missing main in text"); return; }

    delta: i64 = i64(symbol_offset) - i64(place);
    addend: i64 = elf::signed64(elf::le(data, record + 16, 8));
    mut bytes: [u8] = array_repeat::<u8>(u8(0), i64(obj.text.size));
    for (mut i: i64 = 0; i < array_len(bytes); i = i + 1) { bytes[i] = data[i64(obj.text.offset) + i]; }
    elf::save_pc32(bytes, place, delta, addend, u64(main_offset), false);
}

fn main() -> void {
    data: [u8] = fs::read_bytes("input.o", 65536);
    match elf::inspect(data) {
        elf::Inspection::Valid { object: obj } => { apply(data, obj); },
        elf::Inspection::Invalid { reason: why } => { print(why); },
    }
}
