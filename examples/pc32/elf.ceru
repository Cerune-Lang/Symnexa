import "std:fs::bytes" as fs;

pub fn le(data: [u8], at: i64, width: i64) -> u64 {
    mut n: u64 = 0;
    for (mut i: i64 = width; i > 0; i = i - 1) {
        n = (n << 8) | u64(data[at + i - 1]);
    }
    return n;
}

pub fn fits(offset: u64, size: u64, end: u64) -> bool {
    return offset <= end && size <= end - offset;
}

pub type Section {
    kind: u64, flags: u64, offset: u64, size: u64, link: u64, info: u64, alignment: u64, stride: u64
}
pub fn section(data: [u8], table: u64, index: u64) -> Section {
    at: i64 = i64(table + index * 64);
    return Section {
        kind: le(data, at + 4, 4), flags: le(data, at + 8, 8),
        offset: le(data, at + 24, 8), size: le(data, at + 32, 8),
        link: le(data, at + 40, 4), info: le(data, at + 44, 4), alignment: le(data, at + 48, 8),
        stride: le(data, at + 56, 8)
    };
}

// Callers supply a power of two, or zero for a section with no alignment requirement.
pub fn align_up(size: u64, alignment: u64) -> u64 {
    if alignment <= 1 { return size; }
    return size + (alignment - size % alignment) % alignment;
}

pub fn signed64(bits: u64) -> i64 {
    if (bits >> 63) != 0 { return -1 - i64(18446744073709551615u64 - bits); }
    return i64(bits);
}

pub type Object {
    table: u64, count: u64, text_index: u64, text: Section,
    has_rela: bool, rela: Section, sym: Section, names: Section
}
pub enum Inspection { Valid { object: Object }, Invalid { reason: string } }

pub fn inspect(data: [u8]) -> Inspection {
    end: u64 = u64(array_len(data));
    if end < 64 || data[0] != 127 || data[1] != 69 || data[2] != 76 || data[3] != 70
        || data[4] != 2 || data[5] != 1 || le(data, 16, 2) != 1 || le(data, 18, 2) != 62 {
        return Inspection::Invalid { reason: "expected x86-64 little-endian ET_REL" };
    }
    table: u64 = le(data, 40, 8);
    count: u64 = le(data, 60, 2);
    if table < 64 || count == 0 || le(data, 58, 2) != 64 || !fits(table, count * 64, end) {
        return Inspection::Invalid { reason: "invalid section table" };
    }
    mut text_index: u64 = 0;
    mut sym_index: u64 = 0;
    mut sym_count: u64 = 0;
    mut rela_index: u64 = 0;
    for (mut i: u64 = 1; i < count; i = i + 1) {
        s: Section = section(data, table, i);
        if (s.flags & 6) == 6 {
            if s.kind != 1 || (s.flags & 1) != 0 || text_index != 0 {
                return Inspection::Invalid { reason: "expected one executable PROGBITS section" };
            }
            text_index = i;
        }
        if s.kind == 2 {
            sym_count = sym_count + 1;
            sym_index = i;
        }
        if s.kind == 9 || (s.kind == 4 && rela_index != 0) {
            return Inspection::Invalid { reason: "expected one RELA section" };
        }
        if s.kind == 4 { rela_index = i; }
    }
    if text_index == 0 || sym_index == 0 { return Inspection::Invalid { reason: "missing text or symbol table" }; }
    text: Section = section(data, table, text_index);
    rela: Section = section(data, table, rela_index);
    if rela_index != 0 { sym_index = rela.link; }
    else if sym_count != 1 { return Inspection::Invalid { reason: "expected one symbol table" }; }
    if !fits(text.offset, text.size, end) || (rela_index != 0 && (rela.info != text_index || rela.link >= count
        || rela.stride != 24 || rela.size != 24 || !fits(rela.offset, rela.size, end))) {
        return Inspection::Invalid { reason: "expected one relocation into text" };
    }
    sym: Section = section(data, table, sym_index);
    if sym.kind != 2 || sym.stride != 24 || sym.size % 24 != 0 || sym.link >= count
        || !fits(sym.offset, sym.size, end) { return Inspection::Invalid { reason: "invalid symbol table" }; }
    names: Section = section(data, table, sym.link);
    if names.kind != 3 || !fits(names.offset, names.size, end) { return Inspection::Invalid { reason: "invalid string table" }; }

    return Inspection::Valid { object: Object { table: table, count: count, text_index: text_index,
        text: text, has_rela: rela_index != 0, rela: rela, sym: sym, names: names } };
}

pub fn save_pc32(bytes: [u8], place: u64, delta: i64, addend: i64, main_offset: u64) -> void {
    if addend < -2147483648 - delta || addend > 2147483647 - delta { print("PC32 overflow"); return; }
    displacement: i64 = delta + addend;
    mut word: i64 = displacement;
    if word < 0 { word = word + 4294967296; }
    mut patched: [u8] = bytes;
    for (mut i: i64 = 0; i < 4; i = i + 1) {
        patched[i64(place) + i] = u8(word & 255);
        word = word >> 8;
    }
    fs::write_bytes_new("text.bin", patched, 65536);
    // LiseOS profile: image base 0xffffffff80000000; text starts one 4096-byte page later.
    print(18446744071562067968u64 + 4096 + main_offset);
    print(displacement);
}
